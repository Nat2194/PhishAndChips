    "dependencies": {
        "@vitejs/plugin-vue": "^6.0.8",
        "axios": "^1.20.0",
        "core-js": "^3.50.0",
        "socket.io-client": "^4.8.3",
        "vite": "^8.2.2",
        "vue": "^3.5.42"
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@babel/eslint-parser": "^8.0.1",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-vue": "^10.10.0",
        "postcss": "^8.5.26",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "vue-tsc": "^3.3.11"
    },
    "eslintConfig": {
        "root": true,
        "env": {
            "node": true
        },
        "extends": [
